# Copie para .env.local e preencha.
OPENWEATHER_API_KEY=

# ---------- Neon (banco) ----------
NEON_DATABASE_URL=

# ---------- Supabase ----------
# Nao guarda mais nada do TravelIA. Sobrou so a contagem de cliques das faixas
# cruzadas, que vive em tabelas compartilhadas com o ComparaEVs e a Mochila.
# Sem estas duas o carrossel roda igual, so nao conta clique.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Texto da analise
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Audio da previsao (mesma chave acima)
# Vozes: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Modelo que escreve e narra numa chamada so (ex.: gpt-audio-mini, gpt-audio).
# A pronuncia das girias fica melhor, mas a saida e cobrada em tokens de audio,
# bem mais caros que os caracteres do TTS.
#
# VAZIO = pipeline de dois passos (texto no OPENAI_MODEL + narracao no TTS).
# Falha do modelo de audio cai sozinha nesse pipeline, entao da para ligar e
# desligar em producao sem risco de ficar sem previsao. A voz e a mesma do
# OPENAI_TTS_VOICE.
OPENAI_AUDIO_MODEL=

OPENAI_MODEL_RECOMENDACOES=gpt-4o
